<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">
  <!-- Position-first right-arm planning group. `r_arm_tip` is the nub frame at the arm end. -->
  <group name="right_arm">
    <chain base_link="torso_upper_link" tip_link="r_arm_tip"/>
  </group>

  <group_state name="right_arm_ready" group="right_arm">
    <joint name="r_shoulder_pitch_joint" value="0.0"/>
    <joint name="r_shoulder_roll_joint" value="-0.6"/>
    <joint name="r_upper_arm_yaw_joint" value="0.0"/>
    <joint name="r_elbow_pitch_joint" value="-0.8"/>
    <joint name="r_lower_arm_yaw_joint" value="0.0"/>
  </group_state>

  <group_state name="right_arm_tucked" group="right_arm">
    <joint name="r_shoulder_pitch_joint" value="0.2"/>
    <joint name="r_shoulder_roll_joint" value="-1.0"/>
    <joint name="r_upper_arm_yaw_joint" value="0.0"/>
    <joint name="r_elbow_pitch_joint" value="-1.4"/>
    <joint name="r_lower_arm_yaw_joint" value="0.0"/>
  </group_state>

  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_link"/>

  <disable_collisions link1="base_link" link2="torso_lower_link" reason="Adjacent"/>
  <disable_collisions link1="torso_lower_link" link2="torso_upper_link" reason="Adjacent"/>
  <disable_collisions link1="torso_upper_link" link2="r_shoulder_pitch_link" reason="Adjacent"/>
  <disable_collisions link1="r_shoulder_pitch_link" link2="r_shoulder_roll_link" reason="Adjacent"/>
  <disable_collisions link1="r_shoulder_roll_link" link2="r_upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="r_upper_arm_link" link2="r_forearm_link" reason="Adjacent"/>
  <disable_collisions link1="r_forearm_link" link2="r_lower_arm_yaw_link" reason="Adjacent"/>
  <disable_collisions link1="r_lower_arm_yaw_link" link2="r_arm_tip" reason="Adjacent"/>
</robot>
